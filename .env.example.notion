# Notion Integration Configuration
# Copy this file to .env and fill in your credentials

# Notion Integration
# Follow NOTION_SETUP.md to create a Notion integration and get your API key
NOTION_API_KEY=ntn_your_notion_api_key_here

# Notion Database ID
# Your database ID from the URL: https://www.notion.so/High-Growth-Roles-Tracker-...
# Database ID: your_database_id_here
NOTION_DATABASE_ID=your_notion_database_id_here

# LinkedIn Session (optional - uses default if not specified)
# LINKEDIN_SESSION_FILE=linkedin_session.json
