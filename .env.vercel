# ===========================================
# VERCEL ENVIRONMENT VARIABLES
# ===========================================
# Add these to your Vercel project settings:
# Settings > Environment Variables
# ===========================================

# Supabase (REQUIRED)
NEXT_PUBLIC_SUPABASE_URL=https://ouyfcnosxwezwsqxunlj.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Google Sheets (REQUIRED for fallback)
GOOGLE_SHEET_ID=your_google_sheet_id_here

# OPTION 1: Use GOOGLE_CREDENTIALS_JSON (RECOMMENDED for Vercel)
# Paste the ENTIRE contents of your credentials.json file here as a single line
# Example: {"type":"service_account","project_id":"xxx","private_key":"-----BEGIN...","client_email":"xxx@xxx.iam.gserviceaccount.com",...}
GOOGLE_CREDENTIALS_JSON={"replace":"this_with_your_actual_credentials_json"}

# OPTION 2: If you want to use a file, you must upload credentials.json 
# to your Vercel project as a "Secret File" (Vercel dashboard > Storage > Secret Files)
# Then set this path:
GOOGLE_CREDENTIALS_FILE=credentials.json

# Dashboard
SECRET_KEY=your-random-secret-key-here
FLASK_ENV=production

# ===========================================
# SETUP INSTRUCTIONS:
# ===========================================
# 1. Copy your credentials.json content
# 2. Go to Vercel Dashboard > Your Project > Settings > Environment Variables
# 3. Add GOOGLE_CREDENTIALS_JSON with the FULL JSON content
# 4. Make sure to set the environment to Production, Preview, and Development
# 5. Redeploy after adding variables
# ===========================================
