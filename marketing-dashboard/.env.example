[TEMPLATE]
# Tech + Non-Tech Roles Dashboard - Environment Variables
# Copy this file to .env and fill in your values

# Flask Configuration
SECRET_KEY=your-secret-key-change-in-production
DEBUG=True
PORT=5001
HOST=0.0.0.0

# Notion Configuration
# Get your API key from: https://www.notion.so/my-integrations
NOTION_API_KEY=your_notion_api_key_here

# Database ID from your duplicated Jobs Tracker Notion page
# Format: 8-4-4-4-12 UUID (e.g., ae2e82ac-c24f-821c-954c-8111b7bc85ec)
NOTION_DATABASE_ID=ae2e82ac-c24f-821c-954c-8111b7bc85ec

# Dashboard Configuration
JOBS_PER_PAGE=30
AUTO_REFRESH_INTERVAL=60
