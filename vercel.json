{
  "version": 2,
  "name": "consulting-jobs-dashboard",
  "builds": [
    {
      "src": "api/**/*.py",
      "use": "@vercel/python",
      "config": {
        "runtime": "python3.11"
      }
    },
    {
      "src": "dashboard/static/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "dashboard/static/$1"
    },
    {
      "src": "/api/(.*)",
      "dest": "api/$1"
    },
    {
      "src": "/job/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/about",
      "dest": "api/index.py"
    },
    {
      "src": "/test",
      "dest": "api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ],
  "env": {
    "PYTHON_VERSION": "3.11",
    "FLASK_ENV": "production"
  },
  "functions": {
    "api/**/*.py": {
      "maxDuration": 60
    }
  },
  "outputDirectory": "dashboard"
}
